{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "next-dev-3001",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "next-dev-pg",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=postgres://keystone:keystone@localhost:5433/keystone",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000
    }
  ]
}
